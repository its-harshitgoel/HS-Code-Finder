# HSCodeFinder Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# Required: OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the OpenAI model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Set to false when deploying backend-only (e.g. Render API + separate Vercel frontend)
SERVE_FRONTEND=true
