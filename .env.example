# HSCodeFinder Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# Comma-separated list of allowed host headers
ALLOWED_HOSTS=localhost,127.0.0.1

# Whether to serve frontend files locally (true for development, false for production with separate frontend)
# Set to false when deploying Render backend API only, with Vercel frontend
SERVE_FRONTEND=true

# Basic API abuse protection (per IP)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
